    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "Hi! I'm your Learning Assistant 🎓\n\nI can help you learn from articles on the web. Send me a URL and I'll create a summary with the key points. Then I can quiz you to check how much you remember.\n\n📚 Commands:\n/learn <url> — submit a URL to learn from\n/quiz — take a quiz on what you've learned\n/start — show this message\n\nTry sending:\n/learn https://en.wikipedia.org/wiki/Photosynthesis",
        "additionalFields": {}
      },
