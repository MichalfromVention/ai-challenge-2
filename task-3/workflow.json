    {
      "parameters": {
        "jsCode": "let aiOutput;\ntry {\n  let rawOutput = $input.first().json.output;\n  // Strip markdown fences if Claude wrapped JSON in them\n  rawOutput = rawOutput.replace(/^```json\\s*/i, '').replace(/```\\s*$/, '').trim();\n  aiOutput = JSON.parse(rawOutput);\n} catch (e) {\n  throw new Error('Failed to parse AI output: ' + e.message);\n}\n\nconst article = $('Code in JavaScript').first().json;\nconst userId = $('Telegram Trigger').first().json.message.chat.id;\n\nreturn [{\n  json: {\n    user_id: userId,\n    url: article.url,\n    title: article.title,\n    content: article.content,\n    summary: aiOutput.summary_text,\n    difficulty: aiOutput.difficulty\n  }\n}];"
      },
