    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst html = items[0].json.data;\n\n// Extract title\nconst titleMatch = html.match(/<title[^>]*>([\\s\\S]*?)<\\/title>/i);\nconst title = titleMatch ? titleMatch[1].trim() : 'Untitled';\n\n// Strip scripts, styles, HTML tags, and HTML entities\nlet text = html\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, '')\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, '')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/&nbsp;/g, ' ')\n  .replace(/&amp;/g, '&')\n  .replace(/&lt;/g, '<')\n  .replace(/&gt;/g, '>')\n  .replace(/&quot;/g, '\"')\n  .replace(/&#39;/g, \"'\")\n  .replace(/\\s+/g, ' ')\n  .trim();\n\n// Truncate to keep AI input manageable\nif (text.length > 8000) {\n  text = text.substring(0, 8000) + '...';\n}\n\nreturn [{\n  json: {\n    title: title,\n    content: text,\n    url: $('Edit Fields').item.json.url\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        -272
      ],
      "id": "ead196cd-ee8c-4d7a-8b67-14711955b22e",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an educational summarizer (Teacher role). Given the content of an article, produce a structured summary that helps a learner grasp the material.\nTitle: {{ $json.title }}\nURL: {{ $json.url }}\nContent: {{ $json.content }}\nReturn ONLY valid JSON (no markdown fences, no extra text), with this exact structure:\n{\n  \"key_points\": [\"point 1\", \"point 2\", \"point 3\", \"point 4\", \"point 5\"],\n  \"main_concepts\": [\"concept 1\", \"concept 2\"],\n  \"difficulty\": \"easy\",\n  \"summary_text\": \"A formatted summary string ready to send to Telegram. Include the article title in bold, then 5-7 key points as bullets, then main concepts, then a 'Difficulty: [easy/intermediate/advanced]' line at the end. Keep it under 1500 characters.\"\n}\nThe \"difficulty\" field must be one of: \"easy\", \"intermediate\", \"advanced\".\nThe \"key_points\" array must contain 5 to 7 items.\nThe \"summary_text\" must be a complete, well-formatted message in plain text suitable for Telegram.",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
