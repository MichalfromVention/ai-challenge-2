    {
      "parameters": {
        "jsCode": "const callbackData = $('Telegram Trigger').item.json.callback_query.data;\n// format: \"qa:5:B\"\nconst parts = callbackData.split(':');\nconst sessionId = parseInt(parts[1]);\nconst userAnswer = parts[2];\nconst chatId = $('Telegram Trigger').item.json.callback_query.message.chat.id;\n\nreturn [{\n  json: {\n    session_id: sessionId,\n    user_answer: userAnswer,\n    chat_id: chatId\n  }\n}];"
      },
