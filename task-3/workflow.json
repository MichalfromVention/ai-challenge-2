    {
      "parameters": {
        "jsCode": "const session = $input.first().json;\nconst callbackCtx = $('Code in JavaScript6').first().json;\nconst userAnswer = callbackCtx.user_answer;\nconst chatId = callbackCtx.chat_id;\nconst sessionId = callbackCtx.session_id;\n\nconst questions = JSON.parse(session.questions_json);\nconst previousAnswers = JSON.parse(session.answers_json);\nconst currentQuestionIndex = session.current_question;\nconst currentQuestion = questions[currentQuestionIndex];\n\nconst newAnswer = {\n  question_id: currentQuestion.id,\n  user_answer: userAnswer,\n  correct_answer: currentQuestion.correctAnswer,\n  is_correct: userAnswer === currentQuestion.correctAnswer\n};\npreviousAnswers.push(newAnswer);\n\nconst nextQuestionIndex = currentQuestionIndex + 1;\nconst isLastQuestion = nextQuestionIndex >= questions.length;\n\nlet responseText, replyMarkup;\n\nif (isLastQuestion) {\n  const correctCount = previousAnswers.filter(a => a.is_correct).length;\n  const percentage = Math.round((correctCount / questions.length) * 100);\n  \n  let resultText = `🎓 Quiz complete!\\n\\nScore: ${correctCount}/${questions.length} (${percentage}%)\\n\\n`;\n  \n  previousAnswers.forEach((a, idx) => {\n    const q = questions[idx];\n    const emoji = a.is_correct ? '✅' : '❌';\n    resultText += `${emoji} Q${idx + 1}: ${q.question}\\n`;\n    resultText += `Your answer: ${a.user_answer} | Correct: ${a.correct_answer}\\n`;\n    if (!a.is_correct) {\n      resultText += `💡 ${q.explanation}\\n`;\n    }\n    resultText += '\\n';\n  });\n  \n  responseText = resultText;\n  replyMarkup = { inline_keyboard: [] };\n} else {\n  const nextQuestion = questions[nextQuestionIndex];\n  responseText = `Question ${nextQuestionIndex + 1} of ${questions.length}:\\n\\n${nextQuestion.question}`;\n  replyMarkup = {\n    inline_keyboard: ['A', 'B', 'C', 'D'].map(letter => [{\n      text: `${letter}) ${nextQuestion.options[letter].substring(0, 60)}`,\n      callback_data: `qa:${sessionId}:${letter}`\n    }])\n  };\n}\n\nreturn [{\n  json: {\n    session_id: sessionId,\n    chat_id: chatId,\n    text: responseText,\n    reply_markup: replyMarkup,\n    new_current_question: isLastQuestion ? questions.length : nextQuestionIndex,\n    new_answers_json: JSON.stringify(previousAnswers),\n    new_status: isLastQuestion ? 'completed' : 'in_progress'\n  }\n}];"
      },
