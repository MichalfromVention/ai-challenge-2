      "parameters": {
        "jsCode": "const allItems = $input.all();\nconst materials = allItems.filter(item => item.json && item.json.id);\nconst chatId = $('Telegram Trigger').item.json.message.chat.id;\n\nif (materials.length === 0) {\n  return [{\n    json: {\n      chat_id: chatId,\n      text: \"📭 You haven't learned anything yet. Send /learn <url> first.\",\n      reply_markup: { inline_keyboard: [] }\n    }\n  }];\n}\n\nconst buttons = materials.map(item => [{\n  text: item.json.title,\n  callback_data: `qm:${item.json.id}`\n}]);\n\nreturn [{\n  json: {\n    chat_id: chatId,\n    text: \"📚 Pick a material to quiz on:\",\n    reply_markup: { inline_keyboard: buttons }\n  }\n}];"
      },
